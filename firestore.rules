rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS COLLECTION ───────────────────────────────────────────────────
    // Allow users to access their own user documents and subcollections (e.g. savedCode)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow public read access to user profiles so display name checks during signup work
    match /users/{userId} {
      allow read: if true;
    }

    // ── ROOMS COLLECTION & SUBCOLLECTIONS ──────────────────────────────────
    match /rooms/{roomId} {
      // ── READ ─────────────────────────────────────────────────────────────
      // Allow any authenticated user to read room documents (needed to inspect/join rooms)
      allow read: if request.auth != null;

      // ── WRITE ────────────────────────────────────────────────────────────
      allow create: if request.auth != null
                    && !('passwordHash' in request.resource.data)
                    && !('passwordSalt' in request.resource.data);

      allow update: if request.auth != null 
                    && (
                      // Host/Creator can update anything (except writing password hash/salt from client)
                      (request.auth.uid == resource.data.createdBy && !('passwordHash' in request.resource.data) && !('passwordSalt' in request.resource.data))
                      || (
                        // Editors can update code, language, stdin, etc. but cannot modify administrative fields
                        (resource.data.roles[request.auth.uid] == 'editor' || resource.data.roles[request.auth.uid] == 'host')
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'passwordHash', 'passwordSalt', 'roles'])
                      )
                      || (
                        // Viewers can only join/leave/vote but cannot modify code, language, roles, or settings.
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['code', 'language', 'createdBy', 'passwordHash', 'passwordSalt'])
                        && (
                          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles'])
                          || (
                            request.resource.data.roles[request.auth.uid] == 'viewer'
                            && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid])
                          )
                        )
                      )
                    );

      allow delete: if request.auth != null 
                    && request.auth.uid == resource.data.createdBy;

      // ── ROOM SUBCOLLECTIONS ──────────────────────────────────────────────

      // Subcollection for collaborative voting
      match /votes/{voteId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null;
        allow delete: if request.auth != null;
      }

      // Subcollection for collaborative cursors
      match /cursors/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection for chat messages
      match /messages/{messageId} {
        allow read, create: if request.auth != null;
      }

      // Subcollections for WebRTC Video / Voice Calls & Signaling
      match /calls/{callId} {
        allow read, write: if request.auth != null;
      }
      match /calls/{callId}/{document=**} {
        allow read, write: if request.auth != null;
      }

      match /voice_participants/{userId} {
        allow read, write: if request.auth != null;
      }

      match /signals/{signalId} {
        allow read, create, delete: if request.auth != null;
      }

      // Subcollection for Whiteboard Drawings
      match /drawings/{drawingId} {
        allow read, create, delete: if request.auth != null;
      }
    }

    // ── Public room metadata subcollection ───────────────────────────────────
    match /rooms/{roomId}/meta/{document} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // ── All other collections: deny by default ───────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
